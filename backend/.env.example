# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/sminteractive

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANT: Change these to long random strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Game Configuration ────────────────────────────────────────────────────────
# These are fallback values. Live values are read from the Config DB collection.
# Percentages MUST sum to 100.
WINNER_POOL_PERCENTAGE=70
ADMIN_POOL_PERCENTAGE=20
APP_POOL_PERCENTAGE=10

# Timing (in milliseconds)
AUTO_START_TIMEOUT=180000     # 3 minutes
ELIMINATION_INTERVAL=7000     # 7 seconds
MIN_PARTICIPANTS=3
